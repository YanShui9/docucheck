DOCUCHECK_MYSQL_ROOT_PASSWORD=replace-with-random-local-password
DOCUCHECK_MYSQL_PASSWORD=replace-with-random-local-password
# Change if Windows reserves 3307; Compose and host Python read the same port.
DOCUCHECK_MYSQL_PORT=3307

# Local-only OIDC demo; generate private values and realm import with
# python -m backend.app.dev_oidc_realm before starting the identity profile.
DOCUCHECK_OIDC_ADMIN_PASSWORD=
DOCUCHECK_OIDC_DEMO_PASSWORD=
# Shared by Vite and the local OIDC callback generator/synchronizer.
DOCUCHECK_WEB_PORT=15173

# Windows host parser daemon; point to the local MinerU executable for PDF uploads.
DOCUCHECK_MINERU_EXECUTABLE=

# DeepSeek example for the synthetic provider probe and M1 Agent demo. The API key is local-only.
# Choose a model ID explicitly if the account uses a different model.
# Missing credentials fail closed; there is no Fake fallback.
DOCUCHECK_MODEL_PROVIDER=openai-compatible
DOCUCHECK_MODEL_ID=deepseek-flash
DOCUCHECK_MODEL_BASE_URL=https://api.deepseek.com
DOCUCHECK_MODEL_API_KEY=
DOCUCHECK_MODEL_CONTEXT_WINDOW=1000000
# Optional compose.model-tls.yaml overlay only; operator-approved public CA bundle.
# Keep this file outside Git and use an absolute path. Never disable TLS verification.
# DOCUCHECK_MODEL_CA_BUNDLE=E:/PycharmProjects/docucheck/.local-trust/model-ca-bundle.pem

# Milvus: synthetic probe and opt-in local retrieval demo; production API index jobs pending.
# Use the rotated credential locally; never commit it or put it in the URI.
# BGE-M3 uses 1024 dimensions; collections are isolated by actual model digest.
DOCUCHECK_MILVUS_URI=http://127.0.0.1:19530
DOCUCHECK_MILVUS_DATABASE=docucheck_probe
DOCUCHECK_MILVUS_DIMENSION=1024
DOCUCHECK_MILVUS_TIMEOUT=10
DOCUCHECK_MILVUS_TOKEN=
# Only for local provisioning/Attu administration, never for the business Agent.
# Generated and saved by: python -m backend.app.dev_milvus_setup --apply --bootstrap-default-root
# Local provisioning selects the isolated docucheck_probe database.
DOCUCHECK_MILVUS_ROOT_PASSWORD=

# Local-only embedding; install Ollama and run: ollama pull bge-m3
# This is independent of DOCUCHECK_MODEL_* (the DeepSeek chat/tool provider).
DOCUCHECK_EMBEDDING_BASE_URL=http://127.0.0.1:11434
# Optional Docker host bridge override; use the same Ollama port as above.
DOCUCHECK_DOCKER_EMBEDDING_BASE_URL=http://host.docker.internal:11434
DOCUCHECK_EMBEDDING_MODEL=bge-m3:latest
DOCUCHECK_EMBEDDING_TIMEOUT=60

# Durable retrieval stays disabled until the actual model digest and worker runtime are verified.
DOCUCHECK_VECTOR_RETRIEVAL_ENABLED=0
# Required when enabled: ollama-bge-m3-<64 lowercase hex digest>-normalized-v1
DOCUCHECK_INDEX_EMBEDDING_REVISION=
