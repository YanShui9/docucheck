DOCUCHECK_MYSQL_ROOT_PASSWORD=replace-with-random-local-password
DOCUCHECK_MYSQL_PASSWORD=replace-with-random-local-password

# Windows host parser daemon; point to the local MinerU executable for PDF uploads.
DOCUCHECK_MINERU_EXECUTABLE=

# DeepSeek example for the synthetic provider probe and M1 Agent demo. The API key is local-only.
# Choose a model ID explicitly if the account uses a different model.
# Missing credentials fail closed; there is no Fake fallback.
DOCUCHECK_MODEL_PROVIDER=openai-compatible
DOCUCHECK_MODEL_ID=deepseek-flash
DOCUCHECK_MODEL_BASE_URL=https://api.deepseek.com
DOCUCHECK_MODEL_API_KEY=
DOCUCHECK_MODEL_CONTEXT_WINDOW=1000000
