FROM python:3.12-slim

WORKDIR /opt/docucheck/backend

COPY requirements-worker.txt ./
RUN python -m pip install --no-cache-dir -r requirements-worker.txt

COPY app ./app

RUN groupadd --system docucheck && useradd --system --gid docucheck --create-home docucheck
USER docucheck

CMD ["celery", "-A", "app.celery_app:app", "worker", "--loglevel=INFO", "--hostname=docucheck@worker", "--concurrency=1"]
